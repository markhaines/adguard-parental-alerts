# AdGuard Home Configuration
ADGUARD_URL=https://your-adguard-url.com
ADGUARD_USERNAME=your-username
ADGUARD_PASSWORD=your-password

# Pushover Configuration
PUSHOVER_TOKEN=your-pushover-api-token
PUSHOVER_USER=your-pushover-user-key

# Poll interval in seconds (default: 60)
POLL_INTERVAL=60

# Undelivered alert queue cap (default: 500). When the queue exceeds this the
# NEWEST undelivered alerts are kept and the oldest are dropped, and the
# operator is notified via Pushover with the dropped count and time window.
# Notices are exempt from this trim.
MAX_PENDING_ALERTS=500

# Per-alert delivery retries before an alert is dropped and the operator is
# notified (default: 5). Permanently rejected alerts (HTTP 400) are dropped
# immediately. A Pushover configuration fault (invalid token/user, HTTP
# 401/404) never drops queued alerts; they stay queued and retry slowly.
MAX_ALERT_ATTEMPTS=5

# Backoff base in seconds for retrying failed alerts (exponential: 60, 120,
# 240, ...). Default: 60.
ALERT_BACKOFF_BASE=60

# Minimum seconds between operator notifications for the same loss condition
# (lost cursor, dropped alerts, exhausted retries). Notices are queued in the
# durable outbox (delivered at-least-once, exempt from overflow trimming) and
# the cooldown survives restarts. Default: 3600 (1 hour).
NOTICE_COOLDOWN=3600
